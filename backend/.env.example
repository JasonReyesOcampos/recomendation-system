# ─── App ───────────────────────────────────────────
NODE_ENV=development                  # development | production
PORT=3000                             # puerto del backend NestJS

# ─── OpenCode Zen (texto, gratis) ──────────────────
# Obtén la API key en https://opencode.ai/auth → Zen → Claves API
OPENCODE_API_KEY=

# Modelo a usar. Para ver la lista actual:
#   curl -H "Authorization: Bearer $OPENCODE_API_KEY" https://opencode.ai/zen/v1/models
# Si no se define, usa el default del código.
OPENCODE_MODEL=deepseek-v4-flash-free

# ─── Imágenes ──────────────────────────────────────
# Los pósters se generan con Pollinations.ai (gratis, sin API key)
# No hace falta configurar nada más.
